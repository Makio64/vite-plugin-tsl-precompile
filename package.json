{
  "name": "vite-plugin-tsl-precompile-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Vite plugin that AOT-compiles three.js TSL materials marked with .precompile(name).",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/examples-build-contract.mjs && pnpm -r --filter=!examples-* build",
    "lint": "pnpm lint:correctness",
    "lint:correctness": "eslint --max-warnings=0 packages/contract/src packages/plugin/src packages/runtime/src packages/examples/batch packages/site/src packages/site/scripts scripts",
    "test": "pnpm -r --workspace-concurrency=1 --filter=!examples-* test",
    "test:quick": "pnpm test",
    "test:full": "pnpm -r --workspace-concurrency=1 --filter=!examples-* test:full && pnpm test:release-guard",
    "test:release-guard": "node --test scripts/release-state.test.mjs scripts/check-module-budgets.test.mjs scripts/check-diagnostic-globals.test.mjs",
    "test:types": "tsc --project tsconfig.public-types.json",
    "test:generation": "pnpm --filter vite-plugin-tsl-precompile test:generation",
    "test:coverage": "pnpm --filter vite-plugin-tsl-precompile test:coverage",
    "test:three-rewrite": "pnpm --filter vite-plugin-tsl-precompile test:rewrite",
    "test:slim:budget": "node packages/plugin/scripts/check-slim-budgets.mjs",
    "test:slim:budget:prebuilt-helpers": "node packages/plugin/scripts/check-slim-budgets.mjs --profile=prebuilt-helpers",
    "analyze:slim": "node packages/plugin/scripts/check-slim-budgets.mjs --json",
    "test:module:budget": "node scripts/check-module-budgets.mjs",
    "test:diagnostic:globals": "node scripts/check-diagnostic-globals.mjs",
    "analyze:modules": "node scripts/check-module-budgets.mjs --json",
    "vendor:probe": "pnpm --filter vite-plugin-tsl-precompile vendor:probe",
    "test:batch": "pnpm --filter examples-batch test",
    "test:slim": "pnpm --filter examples-batch run:slim",
    "test:e2e": "pnpm --filter examples-batch run:e2e",
    "test:e2e:hard-scene": "pnpm --filter examples-batch run:e2e:hard-scene",
    "test:e2e:campaign": "pnpm --filter examples-batch run:evidence-campaign",
    "test:e2e:tier1": "pnpm --filter examples-batch run:e2e:tier1",
    "test:e2e:tier2": "pnpm --filter examples-batch run:e2e:tier2",
    "test:e2e:tier3": "pnpm --filter examples-batch run:e2e:tier3",
    "test:e2e:tiers": "pnpm test:e2e:tier1 && pnpm test:e2e:tier2 && pnpm test:e2e:tier3",
    "test:e2e:replay": "pnpm --filter examples-batch run:e2e -- --replay-only",
    "test:e2e:shadow-debug": "pnpm --filter examples-shadow-debug test:e2e",
    "test:e2e:postprocessing-debug": "pnpm --filter examples-postprocessing-debug test:e2e",
    "test:e2e:pmrem-debug": "pnpm --filter examples-pmrem-debug test:e2e",
    "test:e2e:compute-debug": "pnpm --filter examples-compute-debug test:e2e",
    "test:e2e:mrt-debug": "pnpm --filter examples-mrt-debug test:e2e",
    "test:examples:contract": "node --test scripts/examples-build-contract.test.mjs && node scripts/examples-build-contract.mjs",
    "test:examples:build": "pnpm test:examples:contract && pnpm -r --filter 'examples-*' --if-present build",
    "test:showcase": "pnpm --filter examples-wow-showcase test:preview",
    "test:examples:ci": "pnpm test:examples:contract && pnpm --filter examples-batch test:diagnostics && pnpm -r --filter 'examples-*' --filter '!examples-ocean' --filter '!examples-wow-showcase' --if-present build && pnpm --filter examples-preview-smoke test && pnpm test:showcase",
    "coverage": "pnpm --filter examples-batch run:coverage-summary",
    "coverage:site": "pnpm coverage && pnpm --filter @tsl-precompile/site data",
    "coverage:retest": "pnpm test:e2e",
    "examples:ui": "pnpm --filter examples-batch ui",
    "verify": "node packages/plugin/src/cli/verify.js packages/examples/ocean/artifacts packages/examples/getting-started/artifacts packages/examples/pbr-shadows/artifacts packages/examples/shadow-debug/artifacts packages/examples/postprocessing-debug/artifacts packages/examples/pmrem-debug/artifacts packages/examples/mrt-debug/artifacts packages/examples/background/artifacts packages/examples/compute-debug/artifacts packages/examples/wow-showcase/artifacts && node packages/plugin/src/cli/verify-support-plan.js",
    "recapture:examples": "node packages/plugin/src/cli/recapture-all.js",
    "pack:dry": "node scripts/release-pack.mjs",
    "test:fresh-project": "pnpm --filter examples-fresh-project-smoke test",
    "test:fresh-project:vite6": "pnpm test:fresh-project -- --vite-version=6.4.3 --typescript-version=5.6.3",
    "test:fresh-project:vite7": "pnpm test:fresh-project -- --vite-version=7.3.6 --typescript-version=5.9.3",
    "test:fresh-project:vite8": "pnpm test:fresh-project -- --vite-version=8.0.16 --typescript-version=5.9.3",
    "test:fresh-project:minimum": "pnpm test:fresh-project:vite6",
    "release:check": "node scripts/release-check.mjs",
    "release:assert-ready": "node scripts/release-state.mjs --require-tag --require-upstream --require-remote-tag",
    "release:integrity": "node scripts/release-tarball-integrity.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "dev": "pnpm dev:ocean",
    "dev:getting-started": "pnpm --filter examples-getting-started dev",
    "dev:pbr-shadows": "pnpm --filter examples-pbr-shadows dev",
    "dev:ocean": "pnpm --filter examples-ocean dev",
    "dev:bloom": "pnpm --filter examples-bloom dev",
    "dev:compute": "pnpm --filter examples-compute dev",
    "dev:background": "pnpm --filter examples-background dev",
    "dev:shadow-debug": "pnpm --filter examples-shadow-debug dev",
    "dev:postprocessing-debug": "pnpm --filter examples-postprocessing-debug dev",
    "dev:pmrem-debug": "pnpm --filter examples-pmrem-debug dev",
    "dev:compute-debug": "pnpm --filter examples-compute-debug dev",
    "dev:mrt-debug": "pnpm --filter examples-mrt-debug dev",
    "dev:showcase": "pnpm --filter examples-wow-showcase dev",
    "capture:showcase": "pnpm --filter examples-wow-showcase capture",
    "site": "pnpm --filter @tsl-precompile/site dev",
    "dev:site": "pnpm --filter @tsl-precompile/site dev",
    "build:site": "pnpm --filter @tsl-precompile/site build"
  },
  "devDependencies": {
    "@types/three": "0.185.1",
    "@types/node": "^25.7.0",
    "eslint": "9.39.4",
    "playwright": "^1.59.1",
    "typescript": "5.9.3"
  }
}
