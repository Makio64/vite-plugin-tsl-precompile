{
  "name": "vite-plugin-tsl-precompile",
  "version": "0.1.0-alpha.0",
  "description": "Vite plugin that AOT-compiles three.js TSL materials marked with .precompile(name).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "David Ronai <davronai@gmail.com>",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Makio64/vite-plugin-tsl-precompile.git",
    "directory": "packages/plugin"
  },
  "main": "./src/index.js",
  "bin": {
    "tsl-precompile-doctor": "./src/cli/doctor.js",
    "tsl-precompile-install-skill": "./src/cli/install-skill.js",
    "tsl-precompile-recapture": "./src/cli/recapture.js",
    "tsl-precompile-verify": "./src/cli/verify.js"
  },
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./build/slim-rewrite": {
      "types": "./types/build/slim-rewrite.d.ts",
      "default": "./build-tools/slim-rewrite.js"
    },
    "./build/capture-request": {
      "types": "./types/build/capture-request.d.ts",
      "default": "./build-tools/capture-request.js"
    },
    "./src/emit-updater.js": {
      "types": "./types/emit-updater.d.ts",
      "default": "./src/emit-updater.js"
    },
    "./src/vendor/compileTSL.js": {
      "types": "./types/vendor/compileTSL.d.ts",
      "default": "./src/vendor/compileTSL.js"
    }
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "build-tools",
    "skill",
    "src",
    "types"
  ],
  "scripts": {
    "test": "node ../../scripts/test.mjs quick --scope=plugin",
    "test:quick": "node ../../scripts/test.mjs quick --scope=plugin",
    "test:unit": "node ../../scripts/test.mjs unit --scope=plugin",
    "test:full": "node ../../scripts/test.mjs full --scope=plugin",
    "test:generation": "node ../../scripts/test.mjs generation --scope=plugin",
    "test:rewrite": "node ../../scripts/test.mjs rewrite --scope=plugin",
    "test:coverage": "node ../../scripts/test.mjs coverage --scope=plugin",
    "verify": "node src/cli/verify.js",
    "recapture": "node src/cli/recapture.js",
    "install-skill": "node scripts/sync-agent-skill.mjs && node src/cli/install-skill.js",
    "vendor:probe": "node scripts/probe-vendor.mjs",
    "prepack": "node scripts/sync-agent-skill.mjs",
    "prepublishOnly": "pnpm run test:full"
  },
  "peerDependencies": {
    "@tsl-precompile/runtime": "workspace:*",
    "@types/three": "0.186.0",
    "three": "0.186.1 || 0.187.0-dev.ec2b745",
    "vite": ">=6.4.3 <9"
  },
  "peerDependenciesMeta": {
    "@tsl-precompile/runtime": { "optional": false },
    "@types/three": { "optional": true },
    "three": { "optional": false },
    "vite": { "optional": false }
  },
  "dependencies": {
    "@tsl-precompile/contract": "workspace:*",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@babel/generator": "^7.29.1",
    "@babel/types": "^7.29.0"
  },
  "keywords": [
    "vite-plugin",
    "three.js",
    "tsl",
    "webgpu",
    "shader",
    "precompile",
    "aot"
  ]
}
