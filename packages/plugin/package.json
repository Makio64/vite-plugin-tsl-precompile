    "@babel/types": "^7.26.0",
    "magic-string": "^0.30.0"
  },
  "keywords": [
    "vite-plugin",
    "three.js",
    "tsl",
    "webgpu",
    "shader",
    "precompile",
    "aot"
  ]
}
