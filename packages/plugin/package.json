{
  "name": "vite-plugin-tsl-precompile",
  "version": "0.1.0",
  "description": "Vite plugin that AOT-compiles three.js TSL materials marked with .precompile(name).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "author": "David Ronai <davronai@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Makio64/vite-plugin-tsl-precompile.git",
    "directory": "packages/plugin"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/*": "./src/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 'test/unit/*.test.js' 'test/coverage/*.test.js'",
    "test:unit": "node --test 'test/unit/*.test.js'",
    "test:coverage": "node --test --test-concurrency=1 'test/coverage/*.test.js'",
    "verify": "node src/cli/verify.js"
  },
  "peerDependencies": {
    "three": ">=0.184.0",
    "vite": ">=5"
  },
  "dependencies": {
    "@tsl-precompile/contract": "workspace:*",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@babel/generator": "^7.29.1",
    "@babel/types": "^7.29.0",
    "magic-string": "^0.30.21"
  },
  "keywords": [
    "vite-plugin",
    "three.js",
    "tsl",
    "webgpu",
    "shader",
    "precompile",
    "aot"
  ]
}
