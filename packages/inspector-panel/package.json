{
  "name": "@tsl-precompile/inspector-panel",
  "version": "0.0.0",
  "private": true,
  "description": "three.js Inspector panel that shows captured TSL precompile artifacts live: user materials, aux passes (background / post-process / lights / pmrem), WGSL previews, and unsupported-kind warnings.",
  "type": "module",
  "license": "MIT",
  "author": "David Ronai <davronai@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Makio64/vite-plugin-tsl-precompile.git",
    "directory": "packages/inspector-panel"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./panel": "./src/panel.js",
    "./data-source": "./src/data-source.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node ../../scripts/test.mjs quick --scope=inspector",
    "test:quick": "node ../../scripts/test.mjs quick --scope=inspector",
    "test:full": "node ../../scripts/test.mjs full --scope=inspector"
  },
  "peerDependencies": {
    "@tsl-precompile/runtime": "workspace:*",
    "three": "0.186.1 || 0.187.0-dev.ec2b745"
  },
  "keywords": [
    "three.js",
    "tsl",
    "inspector",
    "precompile",
    "webgpu",
    "devtools"
  ]
}
