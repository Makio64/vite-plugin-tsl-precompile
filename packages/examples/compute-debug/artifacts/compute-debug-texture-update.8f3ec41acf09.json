    "computeShader": "// Three.js r185 - Node System\n\n// directives\nenable subgroups;\n\n// system\nvar<private> instanceIndex : u32;\n\n// locals\n\n\n// structs\n\n\n// uniforms\n@binding( 0 ) @group( 1 ) var nodeUniform0 : texture_storage_2d<rgba8unorm, write>;\n\nstruct renderStruct {\n\tnodeUniform1 : f32\n};\n@binding( 0 ) @group( 0 )\nvar<uniform> render : renderStruct;\n\nstruct objectStruct {\n\tnodeUniform2 : u32\n};\n@binding( 1 ) @group( 1 )\nvar<uniform> object : objectStruct;\n\n// vars\nvar<private> nodeVar0 : u32;\nvar<private> nodeVar1 : u32;\nvar<private> nodeVar2 : f32;\nvar<private> nodeVar3 : f32;\n\n// codes\n\n\n@compute @workgroup_size( 64, 1, 1 )\nfn main( @builtin( global_invocation_id ) globalId : vec3<u32>,\n\t@builtin( workgroup_id ) workgroupId : vec3<u32>,\n\t@builtin( local_invocation_id ) localId : vec3<u32>,\n\t@builtin( num_workgroups ) numWorkgroups : vec3<u32>,\n\t@builtin( subgroup_size ) subgroupSize : u32 ) {\n\n\t// local vars\n\t\n\n\t// system\n\tinstanceIndex = globalId.x\n\t\t+ globalId.y * ( 64 * numWorkgroups.x )\n\t\t+ globalId.z * ( 64 * numWorkgroups.x ) * ( 1 * numWorkgroups.y );\n\n\t// flow\n\t// code\n\n\tif ( instanceIndex >= object.nodeUniform2 ) { return; }\n\n\tnodeVar0 = ( instanceIndex % 128u );\n\tnodeVar1 = ( instanceIndex / 128u );\n\tnodeVar2 = ( f32( nodeVar0 ) / 128.0 );\n\tnodeVar3 = ( f32( nodeVar1 ) / 128.0 );\n\ttextureStore( nodeUniform0, vec2<u32>( nodeVar0, nodeVar1 ), vec4<f32>( ( ( sin( ( ( nodeVar2 * 12.0 ) + render.nodeUniform1 ) ) * 0.5 ) + 0.5 ), ( ( cos( ( ( nodeVar3 * 9.0 ) - ( render.nodeUniform1 * 0.7 ) ) ) * 0.5 ) + 0.5 ), ( ( sin( ( ( ( nodeVar2 + nodeVar3 ) * 7.0 ) + ( render.nodeUniform1 * 1.3 ) ) ) * 0.5 ) + 0.5 ), 1.0 ) );\n\n\t\n\n}\n",
