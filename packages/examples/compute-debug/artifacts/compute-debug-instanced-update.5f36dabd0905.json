    "computeShader": "// Three.js r187dev - Node System\n\n// directives\nenable subgroups;\n\n// system\nvar<private> instanceIndex : u32;\n\n// locals\n\n\n// structs\n\n\n// uniforms\n\nstruct nodeUniform0Struct {\n\tvalue : array< vec3<f32> >\n};\n@binding( 0 ) @group( 1 )\nvar<storage, read_write> nodeUniform0 : nodeUniform0Struct;\n\nstruct nodeUniform1Struct {\n\tvalue : array< vec3<f32> >\n};\n@binding( 1 ) @group( 1 )\nvar<storage, read_write> nodeUniform1 : nodeUniform1Struct;\n\nstruct renderStruct {\n\tnodeUniform2 : f32\n};\n@binding( 0 ) @group( 0 )\nvar<uniform> render : renderStruct;\n\nstruct objectStruct {\n\tnodeUniform3 : u32\n};\n@binding( 2 ) @group( 1 )\nvar<uniform> object : objectStruct;\n\n// vars\n\n\n// codes\n\n\n@compute @workgroup_size( 64, 1, 1 )\nfn main( @builtin( global_invocation_id ) globalId : vec3<u32>,\n\t@builtin( workgroup_id ) workgroupId : vec3<u32>,\n\t@builtin( local_invocation_id ) localId : vec3<u32>,\n\t@builtin( num_workgroups ) numWorkgroups : vec3<u32>,\n\t@builtin( subgroup_size ) subgroupSize : u32 ) {\n\n\t// local vars\n\t\n\n\t// system\n\tinstanceIndex = globalId.x\n\t\t+ globalId.y * ( 64 * numWorkgroups.x )\n\t\t+ globalId.z * ( 64 * numWorkgroups.x ) * ( 1 * numWorkgroups.y );\n\n\t// flow\n\t// code\n\n\tif ( instanceIndex >= object.nodeUniform3 ) { return; }\n\n\tlet nodeConst0 = ( render.nodeUniform2 * 0.5 );\n\tnodeUniform0.value[ instanceIndex ] = vec3<f32>( ( ( nodeUniform1.value[ instanceIndex ].x * cos( nodeConst0 ) ) - ( nodeUniform1.value[ instanceIndex ].z * sin( nodeConst0 ) ) ), ( sin( ( ( render.nodeUniform2 * 1.6 ) + ( f32( instanceIndex ) * 0.4 ) ) ) * 0.3 ), ( ( nodeUniform1.value[ instanceIndex ].x * sin( nodeConst0 ) ) + ( nodeUniform1.value[ instanceIndex ].z * cos( nodeConst0 ) ) ) );\n\n\t\n\n}\n",
