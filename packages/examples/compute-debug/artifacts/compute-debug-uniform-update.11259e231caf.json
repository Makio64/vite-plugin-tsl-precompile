    "computeShader": "// Three.js r185 - Node System\n\n// directives\nenable subgroups;\n\n// system\nvar<private> instanceIndex : u32;\n\n// locals\n\n\n// structs\n\n\n// uniforms\n@binding( 0 ) @group( 0 ) var nodeUniform0 : texture_storage_2d<rgba8unorm, write>;\n\nstruct objectStruct {\n\tnodeUniform1 : f32,\n\tnodeUniform2 : f32\n};\n@binding( 1 ) @group( 0 )\nvar<uniform> object : objectStruct;\n\n// vars\nvar<private> nodeVar0 : f32;\nvar<private> nodeVar1 : f32;\nvar<private> nodeVar2 : f32;\nvar<private> nodeVar3 : bool;\nvar<private> nodeVar4 : f32;\nvar<private> nodeVar5 : f32;\n\n// codes\n\n\n@compute @workgroup_size( 8, 8, 1 )\nfn main( @builtin( global_invocation_id ) globalId : vec3<u32>,\n\t@builtin( workgroup_id ) workgroupId : vec3<u32>,\n\t@builtin( local_invocation_id ) localId : vec3<u32>,\n\t@builtin( num_workgroups ) numWorkgroups : vec3<u32>,\n\t@builtin( subgroup_size ) subgroupSize : u32 ) {\n\n\t// local vars\n\t\n\n\t// system\n\tinstanceIndex = globalId.x\n\t\t+ globalId.y * ( 8 * numWorkgroups.x )\n\t\t+ globalId.z * ( 8 * numWorkgroups.x ) * ( 8 * numWorkgroups.y );\n\n\t// flow\n\t// code\n\n\tnodeVar1 = ( f32( globalId.x ) / 63.0 );\n\tnodeVar2 = ( f32( globalId.y ) / 63.0 );\n\tnodeVar3 = ( ( nodeVar1 + ( nodeVar2 * 0.5 ) ) > object.nodeUniform1 );\n\n\tif ( nodeVar3 ) {\n\n\t\tnodeVar0 = object.nodeUniform2;\n\n\t} else {\n\n\t\tnodeVar0 = ( nodeVar1 * 0.25 );\n\n\t}\n\n\n\tif ( nodeVar3 ) {\n\n\t\tnodeVar4 = ( nodeVar2 * 0.45 );\n\n\t} else {\n\n\t\tnodeVar4 = ( object.nodeUniform2 * 0.7 );\n\n\t}\n\n\n\tif ( nodeVar3 ) {\n\n\t\tnodeVar5 = ( ( 1.0 - nodeVar1 ) * 0.8 );\n\n\t} else {\n\n\t\tnodeVar5 = ( ( 1.0 - nodeVar2 ) * 0.45 );\n\n\t}\n\n\ttextureStore( nodeUniform0, vec2<u32>( globalId.x, globalId.y ), vec4<f32>( nodeVar0, nodeVar4, nodeVar5, 1.0 ) );\n\n\t\n\n}\n",
