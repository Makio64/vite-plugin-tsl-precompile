{
  "name": "examples-batch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runs extractor/codegen and slim-runtime checks across the tracked Three.js WebGPU and local regression examples.",
  "scripts": {
    "catalogue": "node scripts/build-example-catalogue.mjs",
    "catalogue:check": "node scripts/build-example-catalogue.mjs --check",
    "catalogue:check:corpus": "node scripts/build-example-catalogue.mjs --check --require-three-repo",
    "test": "node run.mjs",
    "run": "node run.mjs",
    "ui": "node run-ui.mjs",
    "run:ui": "node run-ui.mjs",
    "run:slim": "node run-slim.mjs",
    "run:e2e": "node run-e2e-with-coverage.mjs",
    "run:e2e:hard-scene": "node run-hard-scene.mjs",
    "run:evidence-campaign": "node run-evidence-campaign.mjs",
    "run:e2e:tier1": "node run-e2e-with-coverage.mjs --tier=tier1 --report=tier1-report.json",
    "run:e2e:tier2": "node run-e2e-with-coverage.mjs --tier=tier2 --report=tier2-report.json",
    "run:e2e:tier3": "node run-e2e-with-coverage.mjs --tier=tier3 --report=tier3-report.json",
    "run:e2e:raw": "node run-e2e.mjs",
    "run:coverage-summary": "node run-coverage-summary.mjs",
    "test:diagnostics": "node --test 'test/**/*.test.mjs'"
  },
  "devDependencies": {
    "@tsl-precompile/contract": "workspace:*",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0"
  }
}
