{
  "name": "examples-batch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runs extractor/codegen and slim-bundle load-smoke checks across the 206 three.js WebGPU examples.",
  "scripts": {
    "test": "node run.mjs",
    "run": "node run.mjs",
    "ui": "node run-ui.mjs",
    "run:ui": "node run-ui.mjs",
    "run:slim": "node run-slim.mjs",
    "run:e2e": "node run-e2e-with-coverage.mjs",
    "run:e2e:tier1": "node run-e2e-with-coverage.mjs --tier=tier1 --report=tier1-report.json",
    "run:e2e:raw": "node run-e2e.mjs",
    "run:coverage-summary": "node run-coverage-summary.mjs"
  },
  "devDependencies": {
    "@tsl-precompile/contract": "workspace:*",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0"
  }
}
