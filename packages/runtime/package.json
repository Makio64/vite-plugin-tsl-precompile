{
  "name": "@tsl-precompile/runtime",
  "version": "0.1.0",
  "description": "Runtime helpers for vite-plugin-tsl-precompile: UBO writers, artifact loader, dev-time .precompile marker.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "David Ronai <davronai@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Makio64/vite-plugin-tsl-precompile.git",
    "directory": "packages/runtime"
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./writers": {
      "types": "./types/writers.d.ts",
      "default": "./src/writers.js"
    },
    "./marker": {
      "types": "./types/precompile-marker.d.ts",
      "default": "./src/precompile-marker.js"
    },
    "./apply": {
      "types": "./types/apply-precompiled.d.ts",
      "default": "./src/apply-precompiled.js"
    },
    "./loader": {
      "types": "./types/artifact-loader.d.ts",
      "default": "./src/artifact-loader.js"
    },
    "./material-variants": {
      "types": "./types/material-variants.d.ts",
      "default": "./src/material-variants.js"
    },
    "./slim-support": {
      "types": "./types/slim-support/index.d.ts",
      "default": "./src/slim-support/index.js"
    },
    "./slim-support/live-scene-index": {
      "types": "./types/slim-support/live-scene-index.d.ts",
      "default": "./src/slim-support/live-scene-index.js"
    },
    "./slim-support/pmrem": {
      "types": "./types/slim-support/pmrem.d.ts",
      "default": "./src/slim-support/pmrem.js"
    },
    "./slim-support/gpu-texture-share": {
      "types": "./types/slim-support/gpu-texture-share.d.ts",
      "default": "./src/slim-support/gpu-texture-share.js"
    },
    "./slim-support/artifact-texture-wiring": {
      "types": "./types/slim-support/artifact-texture-wiring.d.ts",
      "default": "./src/slim-support/artifact-texture-wiring.js"
    },
    "./slim-support/compute-sync": {
      "types": "./types/slim-support/compute-sync.d.ts",
      "default": "./src/slim-support/compute-sync.js"
    },
    "./slim-support/full-renderer-fallback": {
      "types": "./types/slim-support/full-renderer-fallback.d.ts",
      "default": "./src/slim-support/full-renderer-fallback.js"
    },
    "./slim-support/scene-support": {
      "types": "./types/slim-support/scene-support.d.ts",
      "default": "./src/slim-support/scene-support.js"
    },
    "./slim-support/renderer-lighting": {
      "types": "./types/slim-support/renderer-lighting.d.ts",
      "default": "./src/slim-support/renderer-lighting.js"
    },
    "./slim-support/render-fallback-registry": {
      "types": "./types/slim-support/render-fallback-registry.d.ts",
      "default": "./src/slim-support/render-fallback-registry.js"
    },
    "./slim-support/postprocess-wire": {
      "types": "./types/slim-support/postprocess-wire.d.ts",
      "default": "./src/slim-support/postprocess-wire.js"
    },
    "./slim-support/postprocess-effects": {
      "types": "./types/slim-support/postprocess-effects.d.ts",
      "default": "./src/slim-support/postprocess-effects.js"
    },
    "./slim-support/postprocess-effects-replay": {
      "types": "./types/slim-support/postprocess-effects-replay.d.ts",
      "default": "./src/slim-support/postprocess-effects-replay.js"
    },
    "./slim-support/traa-replay": {
      "types": "./types/slim-support/traa-replay.d.ts",
      "default": "./src/slim-support/traa-replay.js"
    },
    "./slim-support/pass-render-fallback": {
      "types": "./types/slim-support/pass-render-fallback.d.ts",
      "default": "./src/slim-support/pass-render-fallback.js"
    },
    "./slim-support/diagnostics": {
      "types": "./types/slim-support/diagnostics.d.ts",
      "default": "./src/slim-support/diagnostics.js"
    },
    "./slim": "./build/three.webgpu.slim.js",
    "./slim-stubs": "./src/slim-stubs.js"
  },
  "files": [
    "src",
    "build",
    "types"
  ],
  "scripts": {
    "build:slim": "rollup -c rollup.config.js",
    "build": "rollup -c rollup.config.js",
    "test": "node --test --test-concurrency=2 --test-reporter=dot 'test/**/*.test.js'",
    "test:quick": "node --test --test-concurrency=2 --test-reporter=dot 'test/**/*.test.js'",
    "test:full": "node --test --test-concurrency=2 'test/**/*.test.js'",
    "prepublishOnly": "TSLP_FAIL_ON_REWRITE_WARNING=1 pnpm run build && pnpm run test:full"
  },
  "dependencies": {
    "@tsl-precompile/contract": "workspace:*"
  },
  "devDependencies": {
    "rollup": "^4.60.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0"
  },
  "peerDependencies": {
    "three": ">=0.184.0"
  },
  "peerDependenciesMeta": {
    "three": { "optional": false }
  }
}
