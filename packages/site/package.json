{
  "name": "@tsl-precompile/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Landing site for vite-plugin-tsl-precompile.",
  "scripts": {
    "data": "node scripts/build-examples-data.mjs",
    "live": "node scripts/build-live-examples.mjs",
    "dev": "node scripts/build-live-examples.mjs && vite",
    "check:content": "node ../examples/batch/scripts/build-example-catalogue.mjs --check && node scripts/check-content.mjs",
    "build": "node scripts/build-live-examples.mjs && vite build && pnpm check:content",
    "preview": "vite preview",
    "test:live": "node scripts/test-live-example.mjs"
  },
  "dependencies": {
    "three": "0.184.0"
  },
  "devDependencies": {
    "sharp": "^0.35.0",
    "vite": "^8.0.16"
  }
}
