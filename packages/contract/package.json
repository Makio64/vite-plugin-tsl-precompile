{
  "name": "@tsl-precompile/contract",
  "version": "0.1.0-alpha.0",
  "description": "Shared extractor, codegen, and runtime contracts for tsl-precompile packages.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "author": "David Ronai <davronai@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Makio64/vite-plugin-tsl-precompile.git",
    "directory": "packages/contract"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
		".": "./src/index.js",
		"./artifact-content": "./src/artifact-content.js",
		"./artifact-traversal": "./src/artifact-traversal.js",
		"./attribute-generators": "./src/attribute-generators.js",
		"./artifact-variants": "./src/artifact-variants.js",
		"./shader-language": "./src/shader-language.js",
		"./artifact-shape": "./src/artifact-shape.js",
		"./auxiliary-shapes": "./src/auxiliary-shapes.js",
		"./light-identities": "./src/light-identities.js",
    "./diagnostic-globals": "./src/diagnostic-globals.js",
    "./dynamic-bindings": "./src/dynamic-bindings.js",
    "./fragment-outputs": "./src/fragment-outputs.js",
    "./graph-normalize": "./src/graph-normalize.js",
    "./kinds": "./src/kinds.js",
    "./render-context": "./src/render-context.js",
    "./render-selector": "./src/render-selector.js",
    "./render-target-texture": "./src/render-target-texture.js",
    "./output-config": "./src/output-config.js",
    "./cube-render-target": "./src/cube-render-target.js",
    "./compute-bindings": "./src/compute-bindings.js",
    "./material-compute": "./src/material-compute.js",
    "./internal-pass": "./src/internal-pass.js",
    "./pmrem-config": "./src/pmrem-config.js",
    "./vsm-config": "./src/vsm-config.js",
    "./stable-json": "./src/stable-json.js",
    "./slim-bundle-provenance-node": "./src/slim-bundle-provenance-node.js",
    "./slim-three-policy": "./src/slim-three-policy.js",
    "./texture-props": "./src/texture-props.js",
		"./variant-selector-adapter": "./src/variant-selector-adapter.js",
		"./variant-selector-sidecar": "./src/variant-selector-sidecar.js",
    "./virtual-modules": "./src/virtual-modules.js",
    "./versions": "./src/versions.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
	"test": "pnpm run test:unit && pnpm run test:types",
	"test:full": "pnpm run test:unit && pnpm run test:types",
	"test:unit": "node --test --test-concurrency=2 'test/**/*.test.js'",
	"test:types": "tsc --project test/tsconfig.json",
    "prepublishOnly": "pnpm run test:full"
  }
}
