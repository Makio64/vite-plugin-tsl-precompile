node_modules/
.pnpm-store/
.DS_Store
dist/
# Top-level coverage-reporter output (lcov, html, etc.). Pattern intentionally
# uses a leading slash so it does NOT swallow nested fixture dirs like
# `packages/plugin/test/coverage/` which contain real source.
/coverage/
# Scratch directory used by light-shadow-live.test.js when materialising
# emit-updater modules onto disk for execution.
packages/plugin/test/.scratch-shadow-live/
*.log

# Captured artifacts are generated build inputs. Keep canonical example
# recaptures visible to Git so a manifest cannot be committed without the JSON
# it references.
packages/examples/**/artifacts/
# The canonical examples are release/CI fixtures and must survive a clean
# checkout after every recapture.
!packages/examples/getting-started/artifacts/
!packages/examples/getting-started/artifacts/**
# The ocean preview is a release smoke fixture, so its captured production
# inputs must be present in a clean checkout just like the other checked
# example fixtures.
!packages/examples/ocean/artifacts/
!packages/examples/ocean/artifacts/**
!packages/examples/pbr-shadows/artifacts/
!packages/examples/pbr-shadows/artifacts/**
!packages/examples/shadow-debug/artifacts/
!packages/examples/shadow-debug/artifacts/**
!packages/examples/postprocessing-debug/artifacts/
!packages/examples/postprocessing-debug/artifacts/**
!packages/examples/pmrem-debug/artifacts/
!packages/examples/pmrem-debug/artifacts/**
!packages/examples/mrt-debug/artifacts/
!packages/examples/mrt-debug/artifacts/**
!packages/examples/background/artifacts/
!packages/examples/background/artifacts/**
!packages/examples/compute-debug/artifacts/
!packages/examples/compute-debug/artifacts/**
# The ten public free-TSL routes are production site inputs. A clean Pages
# checkout must have their captured material and renderer-output artifacts.
!packages/examples/wow-showcase/artifacts/
!packages/examples/wow-showcase/artifacts/**
packages/examples/**/.tsl-precompile-cache/
packages/site/public/live/
packages/site/public/live-examples.json
packages/site/public/agent/
packages/plugin/skill/

# Playwright/CI scratch
playwright-report/
test-results/
packages/site/results/

# Per-worker e2e reports — only the merged e2e-report.json is checked in
packages/examples/batch/results/e2e-report-worker-*.json

# Local diagnostic snapshots produced while debugging individual examples.
# The only canonical *.json under results/ is e2e-report.json (nested
# artifacts/*.aux.json live in a subdir and aren't matched by this glob).
packages/examples/batch/results/*.json
!packages/examples/batch/results/e2e-report.json

# Agent worktrees (created by Claude Code's isolation: "worktree" option).
# These live under .claude/ but git treats them as untracked since they're
# detached worktrees rooted in the main repo.
.claude/worktrees/

# Local Netlify site linkage
.netlify/
